{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["astro/client", "node"],
    "allowJs": true,
    "checkJs": false
  }
}